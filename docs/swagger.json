              "type": "string",
              "example": "679b9df85fd63c9cafcf87d8"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Delete contact",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
